{
  "expo": {
    "name": "BPS",
    "slug": "bps",
    "scheme": "bps",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0F",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.bps.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.bps.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "BPS a besoin d'accéder à tes photos pour choisir ta photo de profil.",
          "cameraPermission": "BPS a besoin de la caméra pour prendre tes selfies."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BPS a besoin de la caméra frontale pour prendre tes selfies.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF4D2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
